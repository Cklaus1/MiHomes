__pycache__/
*.pyc
*.egg-info/
dist/
build/
.pytest_cache/
*.db
.mihomes/
.coverage

# Node
node_modules/
bridge/node_modules/
npm-debug.log*
cache/npm-packages/

# Stray shell-redirect artifacts (e.g. `pip install "x>=1.0"` without quotes)
=*

# Secrets & credentials — never commit these
*.pem
*.key
*credentials*.json
*_token.json
*secret*.json
.env
.env.*

# Claude Code — per-user local settings (machine-specific paths, personal toggles)
.claude/settings.local.json

# Claude Code — transient worktrees and plan scratch (never commit worktree internals)
.claude/worktrees/
.claude/plans/

# Scratch/working notes
tmp/

# Runtime-generated upload storage (keep the directory, ignore user uploads)
src/web/
src/mihomes/web/static/uploads/*
!src/mihomes/web/static/uploads/.gitkeep

# Home Assistant — runtime files, credentials, and generated data
ha-config/.storage/
ha-config/.cache/
ha-config/.ha_run.lock
ha-config/.HA_VERSION
ha-config/home-assistant.log*
ha-config/home-assistant_v2.db*
