__pycache__/
*.pyc
*.egg-info/
dist/
build/
.pytest_cache/
*.db
.mihomes/
.coverage

# Node
node_modules/
bridge/node_modules/
npm-debug.log*
cache/npm-packages/

# Stray shell-redirect artifacts (e.g. `pip install "x>=1.0"` without quotes)
=*

# Secrets & credentials — never commit these
*.pem
*.key
*credentials*.json
*_token.json
*secret*.json
.env
.env.*

# Claude Code — per-user local settings (machine-specific paths, personal toggles)
.claude/settings.local.json

# NOTE: `src/web/` was listed here to ignore "runtime-generated upload storage".
# That directory only ever existed because of the H26/H34 `parents[4]` bug, which
# resolved the uploads dir to a phantom `src/web/static/uploads`. H26 is fixed and
# test_gateway_review_common.py now asserts uploads land inside the installed
# package, so the pattern matched nothing.
#
# It was not harmless. ripgrep drops an anchored pattern's leading component when
# that component IS the search root, then applies the remainder unanchored — so
# `rg <pattern> src` treated `src/web/` as `web/` and silently skipped all of
# src/mihomes/web/ (23 route modules + templates). Searches from the repo root or
# from src/mihomes were unaffected, which is what made it hard to spot.

# Home Assistant — runtime files, credentials, and generated data
ha-config/.storage/
ha-config/.cache/
ha-config/.ha_run.lock
ha-config/.HA_VERSION
ha-config/home-assistant.log*
ha-config/home-assistant_v2.db*

# Local pg_dump backups taken during debugging — contain password hashes and estate data.
mihomes_dev_backup_*.sql
